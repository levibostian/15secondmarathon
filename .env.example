# Environment Variables Reference
#
# This file is for documentation purposes only.
# DO NOT copy this file or create a .env file.
# Pass these variables directly via docker command (see DOCKER.md)

# YouTube API Key for fetching playlist data
YOUTUBE_API_KEY=your_youtube_api_key_here

# GitHub Personal Access Token for pushing to repository
# Requires 'repo' scope
GITHUB_TOKEN=your_github_token_here

# Git commit author information
GIT_EMAIL=your@email.com
GIT_NAME=Your Name
